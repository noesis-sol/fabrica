exports[`the tools’ JSON Schema > get_ticket matches its snapshot 1`] = `
{
  "description": "Reads your ticket, or one linked to it: its description, design, acceptance criteria, notes, labels and links, and the results of the tickets it depends on.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "The ticket to read; your own when left out.",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+(?:\\.[1-9][0-9]*)*$",
        "type": "string",
      },
    },
    "type": "object",
  },
}
`;

exports[`the tools’ JSON Schema > verdict matches its snapshot 1`] = `
{
  "description": "Gives your verdict on the change, once: PASS when it meets its ticket, or FAIL with the gaps that affect correctness or the ticket's requirements. Weigh the earlier rounds' findings; where you disagree with one, say so in the finding.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "verdict": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "_tag": {
                "enum": [
                  "PASS",
                ],
                "type": "string",
              },
              "findings": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "blocking": {
                      "description": "true when it affects correctness or the ticket's requirements; false for an optional improvement.",
                      "type": "boolean",
                    },
                    "disagreesWithRound": {
                      "description": "The earlier round whose findings this one disagrees with (DISAGREES WITH ROUND <n>); the worker then asks the maintainer rather than going round again.",
                      "minimum": 1,
                      "type": "integer",
                    },
                    "gap": {
                      "description": "What is missing or wrong, with the file and line.",
                      "pattern": "\\S",
                      "type": "string",
                    },
                  },
                  "required": [
                    "gap",
                    "blocking",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "summary": {
                "pattern": "\\S",
                "type": "string",
              },
            },
            "required": [
              "_tag",
              "summary",
              "findings",
            ],
            "type": "object",
          },
          {
            "additionalProperties": false,
            "properties": {
              "_tag": {
                "enum": [
                  "FAIL",
                ],
                "type": "string",
              },
              "findings": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "blocking": {
                      "description": "true when it affects correctness or the ticket's requirements; false for an optional improvement.",
                      "type": "boolean",
                    },
                    "disagreesWithRound": {
                      "description": "The earlier round whose findings this one disagrees with (DISAGREES WITH ROUND <n>); the worker then asks the maintainer rather than going round again.",
                      "minimum": 1,
                      "type": "integer",
                    },
                    "gap": {
                      "description": "What is missing or wrong, with the file and line.",
                      "pattern": "\\S",
                      "type": "string",
                    },
                  },
                  "required": [
                    "gap",
                    "blocking",
                  ],
                  "type": "object",
                },
                "type": "array",
              },
              "summary": {
                "pattern": "\\S",
                "type": "string",
              },
            },
            "required": [
              "_tag",
              "summary",
              "findings",
            ],
            "type": "object",
          },
        ],
      },
    },
    "required": [
      "verdict",
    ],
    "type": "object",
  },
}
`;

exports[`the tools’ JSON Schema > wait_for matches its snapshot 1`] = `
{
  "description": "Ends your turn when your ticket needs work from another ticket that is not on your base yet. Never build on its branch or copy its code, and leave nothing uncommitted. Your ticket is linked as blocked by it, and comes back once it merges.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "needs": {
        "description": "What your ticket needs from it.",
        "pattern": "\\S",
        "type": "string",
      },
      "ticket": {
        "description": "The ticket that must merge first.",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+(?:\\.[1-9][0-9]*)*$",
        "type": "string",
      },
    },
    "required": [
      "ticket",
      "needs",
    ],
    "type": "object",
  },
}
`;
