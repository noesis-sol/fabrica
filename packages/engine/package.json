{
  "name": "@fabrica/engine",
  "version": "0.0.0",
  "private": true,
  "description": "The engine's Effect services.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/engine/bridge.ts",
    "./certificate": "./src/rpc/certificate.ts",
    "./files": "./src/files/index.ts",
    "./paths": "./src/engine/paths.ts",
    "./update": "./src/update/index.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsc --noEmit -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "build": "tsgo -p tsconfig.build.json"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@earendil-works/pi-ai": "1.4.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@effect/sql-sqlite-node": "4.0.0",
    "@fabrica/contracts": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
