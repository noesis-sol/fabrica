  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@fabrica/client": "workspace:*",
    "@fabrica/contracts": "workspace:*",
    "@foldkit/ui": "0.169.0",
    "cytoscape": "3.34.4",
    "cytoscape-dagre": "4.0.1",
    "effect": "4.0.0",
    "foldkit": "0.169.0",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "@foldkit/devtools": "0.169.0",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/pngjs": "6.0.5",
    "electron": "45.1.0",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
