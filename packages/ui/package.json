{
  "name": "@fabrica/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The app's renderer: a Foldkit program.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./styles.css": "./src/styles.css",
    "./theme": "./src/theme/theme.ts",
    "./contrast": "./src/theme/contrast.ts",
    "./host": "./src/app/host.ts",
    "./port": "./src/app/port.ts",
    "./notify": "./src/app/notify.ts",
    "./window-colours": "./src/theme/windowColours.ts"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "effect-tsgo tsc --noEmit -p tsconfig.json",
