{
  "name": "@fabrica/client",
  "version": "0.0.0",
  "private": true,
  "description": "The RPC client and connection management, shared by the app and the CLI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
