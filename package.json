{
  "name": "fabrica",
  "version": "0.0.0",
  "private": true,
  "description": "Runs a backlog of tickets with several coding agents side by side, and merges each finished ticket, checked.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "typecheck": "pnpm --recursive --workspace-concurrency=${FABRICA_CORES:-4} run typecheck && tsgo --noEmit -p scripts/tsconfig.json",
    "typecheck:tsc": "pnpm --recursive --workspace-concurrency=${FABRICA_CORES:-4} run typecheck:tsc && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/test-rerun.ts",
    "check:own": "node scripts/check-own.ts",
    "build": "pnpm --recursive --workspace-concurrency=${FABRICA_CORES:-4} run build"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@types/node": "26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "effect": "4.0.0",
    "happy-dom": "21.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
