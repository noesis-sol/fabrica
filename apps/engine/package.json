{
  "name": "@fabrica/engine-app",
  "version": "0.0.0",
  "private": true,
  "description": "The engine's entry points: the daemon (fabrica serve) and the CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fabrica": "./dist/main.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "dist": "node build/dist.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@effect/platform-node": "4.0.0",
    "@fabrica/client": "workspace:*",
    "@fabrica/contracts": "workspace:*",
    "@fabrica/engine": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@fabrica/testkit": "workspace:*",
    "vite": "8.3.5"
  }
}
