<?xml version="1.0" encoding="UTF-8"?>
<!-- The entitlements the engine distribution's Node is signed with on macOS, under the hardened runtime
     (spec §22.1; .github/workflows/release.yml): Node's own, as its release signs it. V8 compiles code at
     run time, and Node loads native addons. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
