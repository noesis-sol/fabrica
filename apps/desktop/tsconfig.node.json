{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for the preload's page and for the renderer's modules main and the preload share (the
    // theme, the engine port's message).
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  // The connection process and its tests have their own, without the DOM (tsconfig.connection.json).
  "exclude": ["test/connection.test.ts", "test/connection-ssh.test.ts"],
  // The renderer's declarations of the Monaco modules it loads, which its tests reach.
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "build/**/*",
    "test/**/*",
    "../../packages/ui/src/mounts/monaco-modules.d.ts"
  ]
}
